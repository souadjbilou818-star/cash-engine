# ---- Worker (from step 1 of the README) ----
WORKER_URL=https://cash-engine.YOURNAME.workers.dev
ADMIN_KEY=same-long-random-string-as-the-worker-secret

# ---- Who you are (goes in every message; must be real: B2B prospecting requires identifying yourself) ----
AGENCY_NAME=Studio Rive
AGENCY_PERSON=Prénom
AGENCY_PHONE=06 00 00 00 00
OFFER_PRICE=390 €
OFFER_MONTHLY=19 €/mois
OFFER_DELAY=48 h

# ---- Lead sources ----
LEAD_SOURCES=osm,sirene      # osm = OpenStreetMap (has phones), sirene = official registry (recently opened shops)
SIRENE_DAYS=180              # registry: only shops opened in the last N days
SIRENE_MAX_PAGES=40          # registry: pages scanned per activity and postcode

# ---- Targeting ----
AREA_NAME=Paris
AREA_ADMIN_LEVEL=8
# hairdresser beauty restaurant cafe bakery pastry butcher cheese wine caterer florist tailor
# shoe_repair dry_cleaning car_repair bicycle tattoo pet_grooming plumber electrician
CATEGORIES=hairdresser,beauty,restaurant,bakery,florist,tailor,shoe_repair,dry_cleaning,car_repair,tattoo,pet_grooming,caterer
# Empty = all of Paris. Start with 2-3 arrondissements you can walk: 75010,75011,75020
POSTCODES=
DAILY_MAX=60

# ---- Free LLMs, tried in this order; missing keys are skipped ----
LLM_PROVIDERS=gemini,nim,cloudflare,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=
NIM_MODEL=google/gemma-4-31b-it
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---- Lead verification ----
VERIFY_WITH_GEMINI=1        # Gemini + Google Search checks "do they really have no site?"
VERIFY_MAX=80               # max Gemini searches per run
PAGESPEED_API_KEY=          # optional, free key from Google Cloud: adds "score mobile 23/100" to weak-site pitches

# ---- Email (use a separate mailbox, never your main one) ----
REPLY_DOMAIN=                # your domain with Cloudflare Email Routing -> replies go to the AI inbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=
EMAIL_DAILY_CAP=25
